#!/usr/bin/env python3
import json
import os
import subprocess
import sys


def extract_prompt(params):
    prompt = params.get("prompt")
    if isinstance(prompt, str):
        return prompt

    ref = params.get("ref")
    if isinstance(ref, dict):
        text = ref.get("text")
        if isinstance(text, str):
            return text

    messages = params.get("messages")
    if isinstance(messages, list):
        parts = []
        for msg in messages:
            if not isinstance(msg, dict):
                continue
            content = msg.get("content")
            if isinstance(content, str):
                parts.append(content)
            elif isinstance(content, dict):
                text = content.get("text")
                if isinstance(text, str):
                    parts.append(text)
        return "\n".join(parts)

    return ""


def should_use_pro(prompt_text, params):
    threshold = int(os.environ.get("MCP_PROXY_AUTO_PRO_THRESHOLD_CHARS", "6000"))
    if len(prompt_text) >= threshold:
        return True

    tools = params.get("tools")
    if isinstance(tools, list) and len(tools) >= 8:
        return True

    lower = prompt_text.lower()
    pro_hints = (
        "```",
        "architecture",
        "refactor",
        "analyze",
        "design",
        "root cause",
        "incident",
        "migration",
        "compare",
    )
    return any(h in lower for h in pro_hints)


def select_model(prompt_text, params):
    flash_model = os.environ.get("MCP_PROXY_AUTO_FLASH_MODEL", "gemini-3-flash")
    pro_model = os.environ.get("MCP_PROXY_AUTO_PRO_MODEL", "gemini-3-pro")
    return pro_model if should_use_pro(prompt_text, params) else flash_model


def rewrite_request(line):
    try:
        req = json.loads(line)
    except Exception:
        return line, None

    params = req.get("params")
    if not isinstance(params, dict):
        return line, None

    model = params.get("model")
    model_norm = model.strip().lower() if isinstance(model, str) else ""
    if model_norm in ("", "auto", "gemini-auto", "gemini_auto"):
        prompt_text = extract_prompt(params)
        selected = select_model(prompt_text, params)
        params["model"] = selected
        req["params"] = params
        return json.dumps(req, separators=(",", ":")), selected

    return json.dumps(req, separators=(",", ":")), model


def main():
    raw = sys.stdin.read()
    if not raw:
        return 0

    rewritten = []
    selected_model = None
    for line in raw.splitlines():
        if not line.strip():
            continue
        new_line, selected = rewrite_request(line)
        rewritten.append(new_line)
        if selected is not None:
            selected_model = selected

    payload = "\n".join(rewritten)
    if rewritten:
        payload += "\n"

    real_bin = (
        os.environ.get("OP_MCP_PROXY_REAL_BIN")
        or os.environ.get("MCP_PROXY_REAL_BIN")
        or "/usr/local/bin/op-mcp-proxy"
    )

    if os.environ.get("MCP_PROXY_AUTO_DEBUG", "0").lower() in ("1", "true", "yes", "on"):
        print(f"[op-mcp-proxy-select3] selected_model={selected_model}", file=sys.stderr)

    proc = subprocess.run(
        [real_bin],
        input=payload.encode(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=os.environ.copy(),
    )
    sys.stdout.buffer.write(proc.stdout)
    sys.stderr.buffer.write(proc.stderr)
    return proc.returncode


if __name__ == "__main__":
    raise SystemExit(main())
